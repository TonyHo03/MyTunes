<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="152.0" prefWidth="380.0" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="dk.easv.mytunes.gui.DeleteSongViewController">
   <children>
      <Label layoutX="60.0" layoutY="43.0" prefHeight="47.0" prefWidth="288.0" text="Are you sure you wish to delete the song file?">
         <font>
            <Font size="14.0" />
         </font>
      </Label>
      <Label layoutX="97.0" layoutY="23.0" text="This action will delete the song file">
         <font>
            <Font size="14.0" />
         </font>
      </Label>
      <Button layoutX="43.0" layoutY="90.0" mnemonicParsing="false" onAction="#onDeleteSongfileClick" prefHeight="47.0" prefWidth="135.0" text="Yes, delete the file">
         <font>
            <Font size="14.0" />
         </font>
      </Button>
      <Button layoutX="190.0" layoutY="90.0" mnemonicParsing="false" onAction="#onDontDeleteClick" prefHeight="47.0" prefWidth="166.0" text="No, don't delete the file">
         <font>
            <Font size="14.0" />
         </font>
      </Button>
   </children>
</AnchorPane>
