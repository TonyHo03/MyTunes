<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>


<TabPane xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="dk.easv.mytunes.gui.PlaylistViewController">
   <tabs>
      <Tab closable="false" text="Add">
         <content>
            <AnchorPane prefHeight="175.0" prefWidth="305.0">
               <children>
                  <Label layoutX="120.0" layoutY="14.0" text="New Playlist" />
                  <Label layoutX="37.0" layoutY="66.0" prefHeight="18.0" prefWidth="40.0" text="Name:" />
                  <TextField fx:id="txtFldPlaylistName" layoutX="77.0" layoutY="63.0" promptText="Playlist of all time" />
                  <Button layoutX="108.0" layoutY="111.0" mnemonicParsing="false" onAction="#onCancelClick" text="Cancel" />
                  <Button layoutX="171.0" layoutY="111.0" mnemonicParsing="false" onAction="#onCreatePlaylistClick" text="Create" />
               </children>
            </AnchorPane>
         </content>
      </Tab>
      <Tab closable="false" text="Edit">
        <content>
          <AnchorPane minHeight="0.0" minWidth="0.0" prefHeight="180.0" prefWidth="200.0">
               <children>
                  <Label layoutX="123.0" layoutY="14.0" text="Edit Playlist" />
                  <Label layoutX="38.0" layoutY="53.0" prefHeight="18.0" prefWidth="40.0" text="Name:" />
                  <TextField fx:id="txtFldPlaylistNameEdit" layoutX="78.0" layoutY="50.0" promptText="Playlist of all time" />
                  <Button layoutX="123.0" layoutY="90.0" mnemonicParsing="false" onAction="#onCancelClick" text="Cancel" />
                  <Button layoutX="187.0" layoutY="90.0" mnemonicParsing="false" onAction="#onSavePlaylistClick" text="Save" />
               </children>
            </AnchorPane>
        </content>
      </Tab>
   </tabs>
</TabPane>
